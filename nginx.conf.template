server {
    listen 80;
    server_name localhost;

    # DocumentRoot equivalente a Apache
    root /var/www/html/Public;
    index index.php index.html;

    # Logging
    error_log /var/log/nginx/error.log;
    access_log /var/log/nginx/access.log;

    # Allineato a POST_MAX_SIZE di PHP (.env): senza questo nginx rifiuterebbe
    # gli upload di grandi dimensioni prima ancora che arrivino a PHP.
    client_max_body_size ${POST_MAX_SIZE};

    # Equivalente di AllowOverride All per il rewrite
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # Gestione PHP tramite PHP-FPM
    # Il nome "php" è risolto a ogni richiesta (DNS interno di Docker) e non
    # una sola volta all'avvio: quando il container php viene ricreato (es.
    # aggiornamento con --build) cambia IP e nginx risponderebbe 502 fino al
    # proprio riavvio. La variabile $php_upstream non è toccata dall'envsubst
    # dell'immagine nginx, che sostituisce solo le variabili d'ambiente definite.
    location ~ \.php$ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $php_upstream php:9000;
        fastcgi_pass $php_upstream;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
    }

    # Blocca l'accesso ai file nascosti
    location ~ /\. {
        deny all;
    }
}
