# DATABASE_* / ENCRYPTION_PASSPHRASE: stesse variabili documentate in
# www/SismaFramework/.env.example (lette via getenv() dal framework).
# DB_ROOT_PASSWORD: solo per il container MariaDB/phpMyAdmin, non usata da PHP.
DB_ROOT_PASSWORD=change_me_root_password
DATABASE_HOST=db
DATABASE_PORT=3306
DATABASE_NAME=comm_suite
DATABASE_USERNAME=comm_suite_user
DATABASE_PASSWORD=change_me_db_password
ENCRYPTION_PASSPHRASE=change_me_encryption_passphrase

# DEVELOPMENT_ENVIRONMENT / HTTPS_IS_FORCED: lette da www/Config/configFramework.php
# (assenti = false). In sviluppo DEVELOPMENT_ENVIRONMENT=true (errori
# dettagliati, log estesi). In produzione entrambe come sotto se l'applicativo
# è servito in HTTPS da un reverse proxy (tailscale serve, Caddy, Traefik):
# nginx riceve le richieste in HTTP e senza HTTPS_IS_FORCED il framework
# genererebbe URL e cookie per http://.
#   DEVELOPMENT_ENVIRONMENT=false
#   HTTPS_IS_FORCED=true
DEVELOPMENT_ENVIRONMENT=true
HTTPS_IS_FORCED=false

# CONTAINER_PREFIX: prefisso dei nomi dei container (default comm_suite). Da
# cambiare solo per avviare una seconda istanza sulla stessa macchina (es.
# produzione in un'altra cartella: CONTAINER_PREFIX=comm_suite_prod).
CONTAINER_PREFIX=comm_suite

# HTTP_BIND / HTTP_PORT: solo produzione (docker-compose.prod.yml), indirizzo
# e porta dell'host su cui è pubblicato nginx. 127.0.0.1 = raggiungibile solo
# dal reverse proxy sulla stessa macchina, non dalla rete.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# MAIL_*: lette via getenv() dall'applicativo (client SMTP, es. PHPMailer).
# In sviluppo puntano al mock SMTP Mailpit (docker-compose.dev.yml, nessuna
# autenticazione/cifratura). In produzione sostituire con le credenziali del
# provider SMTP reale: cambiando solo questi valori nel .env non serve
# toccare il codice.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_ENCRYPTION=none
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@comm-suite.localhost
MAIL_FROM_NAME=CommSuite

# BACKUP_*: usate dal servizio opzionale docker-compose.backup.yml (dump
# schedulato del database + pulizia dei dump più vecchi della retention).
# Il servizio parte solo se incluso esplicitamente nel comando compose.
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=30

# BACKUP_REMOTES: remote rclone (configurati in ./rclone/rclone.conf, vedi
# README "Copia remota cifrata") su cui copiare i dump dopo ogni backup,
# separati da spazio; vuoto = solo copia locale. Es. solo OneDrive:
# "onedrive-cifrato:", entrambi: "onedrive-cifrato: gdrive-cifrato:".
# BACKUP_REMOTE_RETENTION_DAYS: giorni di conservazione dei dump remoti.
BACKUP_REMOTES=
BACKUP_REMOTE_RETENTION_DAYS=90

# UPLOAD_MAX_FILESIZE / POST_MAX_SIZE / MEMORY_LIMIT / MAX_EXECUTION_TIME /
# MAX_INPUT_TIME: limiti PHP renderizzati da docker-entrypoint.sh in un file
# conf.d ad ogni avvio del container php (upload_max_filesize, post_max_size
# e max_input_time sono direttive PHP_INI_PERDIR: non impostabili a runtime
# dall'applicativo via ini_set()/getenv(), servono in un file ini letto
# all'avvio). POST_MAX_SIZE deve restare >= UPLOAD_MAX_FILESIZE (qualche MB
# in più per l'overhead del multipart/form-data). POST_MAX_SIZE viene
# riusato anche come client_max_body_size di nginx (vedi nginx.conf.template),
# così i due limiti restano sempre allineati: senza questo, nginx
# rifiuterebbe upload di grandi dimensioni prima ancora che arrivino a PHP.
UPLOAD_MAX_FILESIZE=10M
POST_MAX_SIZE=12M
MEMORY_LIMIT=256M
MAX_EXECUTION_TIME=60
MAX_INPUT_TIME=60
